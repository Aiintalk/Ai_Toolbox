# ===================================================================
# 请只修改这个文件。修改完后，不用再改任何命令。
# 所有路径都支持“相对路径（相对本技能目录）”和“绝对路径”。
# ===================================================================

# ========== 0. 项目根路径（可选） ==========
# 留空：默认使用技能目录。
# 若你想让输入/输出独立到别处，可填你自定义的绝对路径。
LENS_ANALYSIS_PROJECT_ROOT=""

# ========== 1. 环境与命令 ==========
PYTHON_BIN="python3"

# 后端目录（可填相对路径或绝对路径）
# 留空：默认用：${LENS_ANALYSIS_PROJECT_ROOT}/backend，若无则会尝试本目录下 backend。
BACKEND_DIR=""

# 虚拟环境目录（可选）
BACKEND_VENV_DIR="backend/.venv"

# ========== 2. 输入与输出路径 ==========
# 扫描输入目录：可放一个或多个 mp4。
INPUT_VIDEO_DIR="storage/raw_videos"

# scan 产物目录（shots.db / shots.json / final_shots.json 的父目录）
SPLIT_OUTPUT_ROOT="storage/media/finished_split_only"

# 日志目录（可选）
SPLIT_LOG_DIR="storage/logs/shot_split_only"

# ========== 3. 配置文件与开关 ==========
# 配置文件路径（可填相对路径或绝对路径）
SCAN_CONFIG_PATH="config/shot_detection.yaml"
FINAL_CONFIG_PATH="config/final_shot_split_only.yaml"

# 固定导出 mp4。若不需要可改 false。
WITH_CLIPS=true

# true 会强制重跑 scan；false 则跳过已完成的视频。
FORCE_RESCAN=false

# true 会对每个 shots.db 强制重新 final_shot；false 只处理未完成项。
FORCE_FINAL_REBUILD=false

# 可选：只处理某个 video_id；留空表示处理 output 下所有 shots.db。
VIDEO_ID=""

# ========== 4. Qwen ==========
# API key：你也可以在这里直接填写；也可留空改为外部环境变量。
QWEN_API_KEY=""

# 如果 QWEN_API_KEY 为空，将从该环境变量读取。
# 注意：这里是环境变量名，不要在这里放完整密钥。
QWEN_API_KEY_ENV_NAME="QWEN_API_KEY"

# ========== 5. 工具自动安装 ==========
# true：缺 python3/ffmpeg/ffprobe 时尝试自动安装（优先 brew，其次 apt/yum/dnf）
# false：缺失时直接报错。
AUTO_INSTALL_TOOLS=true
